# Google Drive Integration (Service Account)
# -------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. Enable the "Google Drive API"
# 4. Go to "Credentials" → "Create Credentials" → "Service Account"
# 5. Download the JSON key file
# 6. Copy client_email and private_key from the JSON file below
# 7. In Google Drive, create a folder for charts
# 8. Share that folder with the service account email (Editor access)
# 9. Copy the folder ID from the URL (the long string after /folders/)

GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
